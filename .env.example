# ── Database ──────────────────────────────────────────────
POSTGRES_USER=forma
POSTGRES_PASSWORD=forma_secret
POSTGRES_DB=forma
DATABASE_URL=postgresql+psycopg://forma:forma_secret@localhost:5432/forma

# ── App ───────────────────────────────────────────────────
APP_ENV=development
APP_SECRET=change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# live = calendarios y last-5 oficiales (API-Football + football-data.org)
# seed = solo laboratorio offline; no se usa en la jornada si hay claves
DATA_SOURCE=live

# ── API-Football (api-sports.io o RapidAPI) ───────────────
# Gratis: 100 req/día. El ETL cachea 12-24h para respetar el cupo.
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
# Si usas RapidAPI:
# API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com
# API_FOOTBALL_RAPIDAPI=true

# ── football-data.org (fallback ligas europeas, 10 req/min) ─
FOOTBALL_DATA_KEY=

# TTL de caché de respuestas crudas (horas)
CACHE_TTL_HOURS=12

# The Odds API: solo backend. Nunca usar VITE_ para esta clave.
ODDS_API_KEY=
